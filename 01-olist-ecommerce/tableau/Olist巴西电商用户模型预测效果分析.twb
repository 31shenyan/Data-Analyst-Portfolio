      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.14k7dkl1ss2c2z1cd4yic0dzjlf7].[avg:avg_delivery_days:qk]&quot;' value='平均配送时效' />
          <alias key='&quot;[federated.14k7dkl1ss2c2z1cd4yic0dzjlf7].[avg:frequency:qk]&quot;' value=' avg_Frequency' />
          <alias key='&quot;[federated.14k7dkl1ss2c2z1cd4yic0dzjlf7].[avg:monetary:qk]&quot;' value='avg_Monetary' />
          <alias key='&quot;[federated.14k7dkl1ss2c2z1cd4yic0dzjlf7].[avg:recency:qk]&quot;' value='avg_Recency' />
          <alias key='&quot;[federated.14k7dkl1ss2c2z1cd4yic0dzjlf7].[avg:total_spend:qk]&quot;' value='用户平均消费总额' />
        </aliases>
      </column>
      <column caption='用户价值等级' datatype='string' name='[Calculation_447263742973292544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [RFM_total] &gt;= 10 THEN &apos;高价值用户&apos;&#13;&#10;ELSEIF [RFM_total] &gt;= 7 THEN &apos;中价值用户&apos;&#13;&#10;ELSEIF [RFM_total] &gt;= 4 THEN &apos;低价值用户&apos;&#13;&#10;ELSE &apos;流失用户&apos;&#13;&#10;END' />
      </column>
      <column caption='预测 / 真实价值匹配判定' datatype='string' name='[Calculation_447263742975041537]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([high_value] = 1 AND [RFM_total] &gt;= 7) OR ([high_value] = 0 AND [RFM_total] &lt; 7)&#13;&#10;THEN &apos;匹配&apos;&#13;&#10;ELSE &apos;偏差&apos;&#13;&#10;END' />
      </column>
      <column caption='消费能力分层' datatype='string' name='[Calculation_447263742975115266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [total_spend] &gt;= [Calculation_447263742975787011] THEN &apos;高消费&apos;&#13;&#10;ELSEIF [total_spend] &gt;= [Calculation_447263742975856644] THEN &apos;中消费&apos;&#13;&#10;ELSE &apos;低消费&apos;&#13;&#10;END' />
      </column>
      <column caption='Total Spend_80th' datatype='real' name='[Calculation_447263742975787011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : PERCENTILE([total_spend], 0.8)}' />
      </column>
      <column caption='Total Spend_50th' datatype='real' name='[Calculation_447263742975856644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : PERCENTILE([total_spend], 0.5)}' />
      </column>
      <column caption='配送时效评价关联度' datatype='string' name='[Calculation_447263742976069637]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [avg_delivery_days] &lt;= 5 THEN &apos;优质配送&apos;&#13;&#10;ELSEIF [avg_delivery_days] &lt;= 10 THEN &apos;标准配送&apos;&#13;&#10;ELSE &apos;低效配送&apos;&#13;&#10;END' />
      </column>
      <column caption='价值筛选标签' datatype='string' name='[Calculation_447263742977486854]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [RFM_total] &gt;= [Parameters].[参数 1] THEN &apos;高价值候选&apos; ELSE &apos;普通用户&apos; END' />
      </column>
      <column caption='总用户数' datatype='integer' name='[Calculation_447263742981533703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
      <column caption='真实高价值用户数' datatype='integer' name='[Calculation_447263742981861384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [high_value] = 1 THEN [customer_id] END)' />
      </column>
      <column caption='模型匹配准确率' datatype='real' name='[Calculation_447263742981976073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_447263742975041537] = &apos;匹配&apos; THEN [customer_id] END) / COUNTD([customer_id])' />
      </column>
      <column caption='RFM总分分档' datatype='string' name='[Calculation_447263742985678858]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [RFM_total] &lt;= 3 THEN &apos;1-3分&apos;&#13;&#10;ELSEIF [RFM_total] &lt;= 6 THEN &apos;4-6分&apos;&#13;&#10;ELSEIF [RFM_total] &lt;= 9 THEN &apos;7-9分&apos;&#13;&#10;ELSEIF [RFM_total] &lt;= 12 THEN &apos;10-12分&apos;&#13;&#10;ELSE &apos;13分及以上&apos; &#13;&#10;END' />
      </column>
      <column caption='高亮标记' datatype='string' name='[Calculation_447263743003848715]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF INDEX() &lt;= 3 THEN &apos;高亮&apos; ELSE &apos;普通&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='用户生命周期阶段' datatype='string' name='[Calculation_447263743014322188]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [recency] &lt;= 30 THEN &apos;活跃用户（近30天消费）&apos;&#13;&#10;ELSEIF [recency] &lt;= 90 THEN &apos;沉睡用户（31-90天未消费）&apos;&#13;&#10;ELSE &apos;流失用户（90天以上未消费）&apos;&#13;&#10;END' />
      </column>
