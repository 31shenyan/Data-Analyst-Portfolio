      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Calculation_5972617535499608071:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;A级潜力用户&quot;</bucket>
            </map>
