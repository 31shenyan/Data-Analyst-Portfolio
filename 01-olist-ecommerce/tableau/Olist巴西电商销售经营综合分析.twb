      <aliases enabled='yes' />
      <column caption='整体客单价' datatype='real' name='[Calculation_4696972939297267712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payment_value])/COUNTD([order_id])' />
      </column>
      <column caption='运费占营收比重' datatype='real' name='[Calculation_4696972939297615873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([freight_value])/SUM([payment_value])' />
      </column>
      <column caption='订单延误占比' datatype='real' name='[Calculation_4696972939297701890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [delivery_days] &gt;7 THEN [order_id] END)/COUNTD([order_id])' />
      </column>
      <column caption='单商品均价' datatype='real' name='[Calculation_4696972939297787907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([price])' />
      </column>
      <column caption='平均配送天数' datatype='real' name='[Calculation_4696972939297861636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([delivery_days])' />
      </column>
      <column caption='环比销售额增长率' datatype='real' name='[Calculation_4696972939298349061]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF INDEX() = 1 THEN NULL&#13;&#10;ELSE&#13;&#10;ROUND(&#13;&#10;    (SUM([payment_value]) - LOOKUP(SUM([payment_value]), -1)) &#13;&#10;    / LOOKUP(SUM([payment_value]), -1)&#13;&#10;, 4)&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='同期同比销售额差值' datatype='real' name='[Calculation_4696972939298435078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payment_value]) - LOOKUP(SUM([payment_value]),-12)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='订单量环比增速' datatype='real' name='[Calculation_4696972939298508807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNTD([order_id])-LOOKUP(COUNTD([order_id]),-1))/LOOKUP(COUNTD([order_id]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='配送时效等级' datatype='string' name='[Calculation_4696972939298578440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [delivery_days]&lt;=3 THEN &apos;极速配送&apos;&#13;&#10;ELSEIF [delivery_days]&lt;=7 THEN &apos;标准配送&apos;&#13;&#10;ELSE &apos;超时配送&apos;&#13;&#10;END' />
      </column>
      <column caption='品类营收占比' datatype='real' name='[Calculation_4696972939298660361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payment_value])/TOTAL(SUM([payment_value]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='动态时间维度' datatype='date' name='[Calculation_4696972939299581962]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[参数 1] = &quot;年&quot;&#13;&#10;THEN DATE(DATETRUNC(&apos;year&apos;, [order_purchase_timestamp]))&#13;&#10;&#13;&#10;ELSEIF [Parameters].[参数 1] = &quot;季度&quot;&#13;&#10;THEN DATE(DATETRUNC(&apos;quarter&apos;, [order_purchase_timestamp]))&#13;&#10;&#13;&#10;ELSEIF [Parameters].[参数 1] = &quot;月度&quot;&#13;&#10;THEN DATE(DATETRUNC(&apos;month&apos;, [order_purchase_timestamp]))&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='订单总数' datatype='integer' datatype-customized='true' name='[Order Id (复制)_4671358718143492116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_status] = &quot;delivered&quot; THEN [order_id] END)' />
      </column>
      <column caption='总营收' datatype='real' name='[Payment Value (复制)_4671358718145130517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[payment_value]' />
      </column>
