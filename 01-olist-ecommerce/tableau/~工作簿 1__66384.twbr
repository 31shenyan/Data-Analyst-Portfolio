            </column>
            <column caption='动态时间维度' datatype='date' name='[Calculation_4696972939299581962]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[参数 1] = &quot;年&quot;&#13;&#10;THEN DATE(DATETRUNC(&apos;year&apos;, [order_purchase_timestamp]))&#13;&#10;&#13;&#10;ELSEIF [Parameters].[参数 1] = &quot;季度&quot;&#13;&#10;THEN DATE(DATETRUNC(&apos;quarter&apos;, [order_purchase_timestamp]))&#13;&#10;&#13;&#10;ELSEIF [Parameters].[参数 1] = &quot;月度&quot;&#13;&#10;THEN DATE(DATETRUNC(&apos;month&apos;, [order_purchase_timestamp]))&#13;&#10;&#13;&#10;END' />
