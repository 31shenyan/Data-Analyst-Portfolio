      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='order_master' name='federated.0y7po8p1un25bb11fy40g1fwmppi' />
          </datasources>
          <datasource-dependencies datasource='federated.0y7po8p1un25bb11fy40g1fwmppi'>
            <column caption='订单延误占比' datatype='real' name='[Calculation_4696972939297701890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [delivery_days] &gt;7 THEN [order_id] END)/COUNTD([order_id])' />
            </column>
            <column caption='平均配送天数' datatype='real' name='[Calculation_4696972939297861636]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([delivery_days])' />
            </column>
            <column caption='配送时效等级' datatype='string' name='[Calculation_4696972939298578440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [delivery_days]&lt;=3 THEN &apos;极速配送&apos;&#13;&#10;ELSEIF [delivery_days]&lt;=7 THEN &apos;标准配送&apos;&#13;&#10;ELSE &apos;超时配送&apos;&#13;&#10;END' />
            </column>
            <column caption='订单总数' datatype='integer' datatype-customized='true' name='[Order Id (复制)_4671358718143492116]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_status] = &quot;delivered&quot; THEN [order_id] END)' />
            </column>
            <column caption='总营收' datatype='real' name='[Payment Value (复制)_4671358718145130517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[payment_value]' />
            </column>
            <column caption='Delivery Days' datatype='real' name='[delivery_days]' role='measure' type='quantitative' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Payment Type' datatype='string' name='[payment_type]' role='dimension' type='nominal' />
            <column caption='Payment Value' datatype='real' name='[payment_value]' role='measure' type='quantitative' />
            <column caption='Product Category Name English' datatype='string' name='[product_category_name_english]' role='dimension' type='nominal' />
            <column-instance column='[Payment Value (复制)_4671358718145130517]' derivation='Sum' name='[sum:Payment Value (复制)_4671358718145130517:qk]' pivot='key' type='quantitative' />
