              <calculation class='tableau' formula='IF INDEX() = 1 THEN NULL&#13;&#10;ELSE&#13;&#10;ROUND(&#13;&#10;    (SUM([payment_value]) - LOOKUP(SUM([payment_value]), -1)) &#13;&#10;    / LOOKUP(SUM([payment_value]), -1)&#13;&#10;, 4)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
