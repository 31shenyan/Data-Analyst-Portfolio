      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.00jrvyq1uyq5z713gv6ij0tuq5h2].[sum:Calculation_5972617535499104260:qk]&quot;' value='复购潜力' />
          <alias key='&quot;[federated.00jrvyq1uyq5z713gv6ij0tuq5h2].[sum:frequency:qk]&quot;' value='消费频次' />
          <alias key='&quot;[federated.00jrvyq1uyq5z713gv6ij0tuq5h2].[sum:monetary:qk]&quot;' value='消费金额' />
          <alias key='&quot;[federated.00jrvyq1uyq5z713gv6ij0tuq5h2].[sum:recency:qk]&quot;' value='最近消费' />
        </aliases>
      </column>
      <column aggregation='Sum' caption='用户价值总分' datatype='integer' name='[Calculation_5972617535489155072]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[R_score]+[F_score]+[M_score]' />
      </column>
      <column caption='活跃等级判定' datatype='string' name='[Calculation_5972617535489249281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [R_score]&gt;=4 THEN &apos;高活跃用户&apos; ELSE &apos;低活跃用户&apos; END' />
      </column>
      <column caption='消费档位划分' datatype='string' name='[Calculation_5972617535489318914]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5972617535498903555] &gt;= 0.8&#13;&#10;THEN &apos;高消费层级&apos;&#13;&#10;ELSEIF [Calculation_5972617535498903555] &gt;= 0.5&#13;&#10;THEN &apos;中等消费层级&apos;&#13;&#10;ELSE &apos;低消费层级&apos;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='消费金额排名' datatype='real' name='[Calculation_5972617535498903555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE(SUM([monetary]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='复购潜力分值' datatype='real' name='[Calculation_5972617535499104260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[F_score]*0.5+[R_score]*0.3+[M_score]*0.2' />
      </column>
      <column caption='人均累计消费' datatype='real' name='[Calculation_5972617535499194373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monetary])/COUNTD([customer_id])' />
      </column>
      <column caption='价值分层区间' datatype='string' name='[Calculation_5972617535499472902]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5972617535489155072]&gt;=[Parameters].[参数 1] THEN &apos;高分价值用户&apos; ELSE &apos;普通用户&apos; END' />
      </column>
      <column caption='RFM综合等级' datatype='string' name='[Calculation_5972617535499608071]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5972617535489155072] &gt;= 9 THEN &apos;S级核心用户&apos;&#13;&#10;ELSEIF [Calculation_5972617535489155072] &gt;= 6 THEN &apos;A级潜力用户&apos;&#13;&#10;ELSEIF [Calculation_5972617535489155072] &gt;= 3 THEN &apos;B级普通用户&apos;&#13;&#10;ELSE &apos;C级流失用户&apos;&#13;&#10;END' />
      </column>
      <column caption='消费频次区间' datatype='string' name='[Calculation_5972617535499853832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [frequency]&gt;=10 THEN &apos;高频消费&apos;&#13;&#10;ELSEIF [frequency]&gt;=3 THEN &apos;中频消费&apos;&#13;&#10;ELSE &apos;低频消费&apos;&#13;&#10;END' />
      </column>
      <column caption='价值波动系数' datatype='real' name='[Calculation_5972617535499984905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([monetary])&#13;&#10;    - LOOKUP(WINDOW_AVG(SUM([monetary])), 0))/&#13;&#10;IF LOOKUP(WINDOW_STDEV(SUM([monetary])), 0) = 0 THEN 1&#13;&#10;ELSE LOOKUP(WINDOW_STDEV(SUM([monetary])), 0)&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='S 级核心用户占比' datatype='real' name='[Calculation_5972617535502549003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_5972617535499608071]=&apos;S级核心用户&apos; THEN [customer_id] END)/COUNTD([customer_id])' />
      </column>
      <column caption='活跃用户占比' datatype='real' name='[Calculation_5972617535503130636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_5972617535489249281]=&apos;高活跃用户&apos; THEN [customer_id] END)/COUNTD([customer_id])' />
      </column>
      <column caption='角度' datatype='real' name='[Calculation_863846708470956032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [指标名称]&#13;&#10;    WHEN &apos;recency&apos; THEN 0&#13;&#10;    WHEN &apos;frequency&apos; THEN PI()/2&#13;&#10;    WHEN &apos;monetary&apos; THEN PI()&#13;&#10;    WHEN &apos;复购潜力分值&apos; THEN 3*PI()/2&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='X轴坐标' datatype='real' name='[Calculation_863846708471054337]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='COS([Calculation_863846708470956032]) * [指标值]' />
      </column>
      <column aggregation='Sum' caption='Y轴坐标' datatype='real' name='[Calculation_863846708471132162]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='SIN([Calculation_863846708470956032]) * [指标值]' />
      </column>
      <column caption='总用户数' datatype='integer' datatype-customized='true' name='[Customer Id (复制)_5972617535501860874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
